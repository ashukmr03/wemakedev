{
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://carecircle-api-i870.onrender.com/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://carecircle-api-i870.onrender.com/health"
    },
    {
      "source": "/docs",
      "destination": "https://carecircle-api-i870.onrender.com/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "https://carecircle-api-i870.onrender.com/openapi.json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
